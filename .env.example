# Microsoft Fabric (OneLake) settings for npm run fabric:export -- --push and npm run fabric:pull.
# Copy to .env.local (gitignored) and fill in. Never commit real values. Never prefix with NEXT_PUBLIC_.
# The site itself never reads these; only scripts/fabric/* does.
FABRIC_WORKSPACE=
FABRIC_LAKEHOUSE=
FABRIC_FOLDER=bourbon-guide
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=

# The deployed site address, public by design (no trailing slash). Sets the canonical URL and fills sitemap.xml.
# Without it the site has no canonical tag and an empty sitemap.
NEXT_PUBLIC_SITE_URL=
